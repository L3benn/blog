---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

export type Props = {
	posts: CollectionEntry<'blog'>[];
	currentPath?: string;
};

const { posts, currentPath = '' } = Astro.props;

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const latest = posts.slice(0, 5);
---

<aside class="sidebar">
	<div class="widget">
		<h3 class="widget-title">About</h3>
		<p class="widget-text">
			Security researcher & CTF enthusiast. Breaking things, learning, sharing writeups on penetration testing, AD security, and red teaming.
		</p>
	</div>

	<div class="widget">
		<h3 class="widget-title">Recent Posts</h3>
		<ul class="recent-list">
			{latest.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.thumbnail && <img src={post.data.thumbnail} alt="" loading="lazy" />}
						<div>
							<span class="recent-title">{post.data.title}</span>
							<span class="recent-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>

	<div class="widget">
		<h3 class="widget-title">Tags</h3>
		<div class="tag-cloud">
			{allTags.map((tag) => (
				<a href={`/writeups/${tag === 'htb' ? 'htb' : tag === 'ctf' ? 'ctf' : '#'}`} class="tag">
					{tag}
				</a>
			))}
		</div>
	</div>

	<div class="widget">
		<h3 class="widget-title">Explore</h3>
		<ul class="explore-list">
			<li><a href="/writeups/">All Writeups</a></li>
			<li><a href="/writeups/htb/">HTB Writeups</a></li>
			<li><a href="/writeups/ctf/">CTF Writeups</a></li>
			<li><a href="/certs/">Certifications</a></li>
			<li><a href="/cheatsheets/">Cheatsheets</a></li>
		</ul>
	</div>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.2em;
	}
	.widget {
		
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-radius: 0;
		padding: 1.2em;
	}
	.widget-title {
		margin: 0 0 0.7em;
		font-size: 0.95em;
		color: #e0ede6;
		font-weight: 600;
	}
	.widget-text {
		color: #8ab8a8;
		font-size: 0.82em;
		line-height: 1.55;
		margin: 0;
	}

	.recent-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent-list li {
		padding: 0.45em 0;
	}
	.recent-list li:last-child {
		padding-bottom: 0;
	}
	.recent-list a {
		display: flex;
		gap: 0.6em;
		text-decoration: none;
		color: inherit;
		align-items: flex-start;
	}
	.recent-list img {
		width: 44px;
		height: 44px;
		border-radius: 0;
		object-fit: cover;
		flex-shrink: 0;
		background: #333333;
	}
	.recent-title {
		display: block;
		font-size: 0.8em;
		font-weight: 600;
		color: #c8ded5;
		line-height: 1.3;
		margin-bottom: 0.15em;
	}
	.recent-date {
		display: block;
		font-size: 0.72em;
		color: #8ab8a8;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em;
	}

	.explore-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.explore-list li {
		padding: 0.3em 0;
	}
	.explore-list a {
		color: #8ab8a8;
		text-decoration: none;
		font-size: 0.82em;
		font-weight: 500;
		transition: color 0.2s;
	}
	.explore-list a:hover {
		color: #4fc4b8;
	}
</style>
