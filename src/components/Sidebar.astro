---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

export type Props = {
	posts: CollectionEntry<'blog'>[];
	currentPath?: string;
};

const { posts, currentPath = '' } = Astro.props;

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const latest = posts.slice(0, 5);
---

<aside class="sidebar">
	<div class="widget">
		<h3 class="widget-title">About</h3>
		<p class="widget-text">
			Security researcher & CTF enthusiast. Breaking things, learning, sharing.
		</p>
	</div>

	<div class="widget">
		<h3 class="widget-title">Recent Posts</h3>
		<ul class="recent-list">
			{latest.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.thumbnail && <img src={post.data.thumbnail} alt="" loading="lazy" />}
						<div>
							<span class="recent-title">{post.data.title}</span>
							<span class="recent-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>

	<div class="widget">
		<h3 class="widget-title">Tags</h3>
		<div class="tag-cloud">
			{allTags.map((tag) => (
				<a href={`/writeups/${tag === 'htb' ? 'htb' : tag === 'ctf' ? 'ctf' : '#'}`} class="tag">
					{tag}
				</a>
			))}
		</div>
	</div>

	<div class="widget">
		<h3 class="widget-title">Explore</h3>
		<ul class="explore-list">
			<li><a href="/writeups/">All Writeups</a></li>
			<li><a href="/writeups/htb/">HTB Writeups</a></li>
			<li><a href="/writeups/ctf/">CTF Writeups</a></li>
			<li><a href="/certs/">Certifications</a></li>
			<li><a href="/cheatsheets/">Cheatsheets</a></li>
		</ul>
	</div>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5em;
	}
	.widget {
		background: rgba(235,232,222,0.78);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-radius: 12px;
		padding: 1.3em;
	}
	.widget-title {
		margin: 0 0 0.8em;
		font-size: 1em;
		color: #0f4f53;
	}
	.widget-text {
		color: #3a6b65;
		font-size: 0.85em;
		line-height: 1.5;
		margin: 0;
	}

	.recent-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent-list li {
		padding: 0.5em 0;
		border-bottom: 1px solid rgba(200,218,195,0.3);
	}
	.recent-list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}
	.recent-list a {
		display: flex;
		gap: 0.7em;
		text-decoration: none;
		color: inherit;
		align-items: flex-start;
	}
	.recent-list img {
		width: 50px;
		height: 50px;
		border-radius: 6px;
		object-fit: cover;
		flex-shrink: 0;
		background: #d8e4c7;
	}
	.recent-title {
		display: block;
		font-size: 0.82em;
		font-weight: 600;
		color: #0f4f53;
		line-height: 1.3;
		margin-bottom: 0.2em;
	}
	.recent-date {
		display: block;
		font-size: 0.75em;
		color: #5c9a91;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tag-cloud .tag {
		background: rgba(191, 216, 194, 0.4);
		color: #1f6666;
		padding: 0.2em 0.6em;
		border-radius: 4px;
		font-size: 0.75em;
		text-decoration: none;
		transition: all 0.2s;
	}
	.tag-cloud .tag:hover {
		background: #2e7d79;
		color: #fff;
	}

	.explore-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.explore-list li {
		padding: 0.35em 0;
	}
	.explore-list a {
		color: #2e7d79;
		text-decoration: none;
		font-size: 0.85em;
		font-weight: 600;
		transition: color 0.2s;
	}
	.explore-list a:hover {
		color: #1f6666;
		text-decoration: underline;
	}
</style>
