---
interface Props {
	size?: number;
	class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg class:list={['sharingan', className]} viewBox="0 0 100 100" width={size} height={size} aria-hidden="true">
	<circle class="iris" cx="50" cy="50" r="46" stroke="#05070b" stroke-width="6"></circle>
	<circle cx="50" cy="50" r="26" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="2"></circle>
	<circle cx="50" cy="50" r="9" fill="#05070b"></circle>
	<g class="tomoe" fill="#05070b">
		{[0, 120, 240].map((deg) => (
			<g transform={`rotate(${deg} 50 50)`}>
				<circle cx="50" cy="24" r="7"></circle>
				<path d="M43 24 C43 13 56 8 65 13 C58 13 55 18 57 24 Z"></path>
			</g>
		))}
	</g>
</svg>

<style>
	.sharingan {
		display: block;
		flex-shrink: 0;
	}
	.iris {
		fill: #e5383b;
	}
	.tomoe {
		transform-origin: 50px 50px;
	}
</style>
