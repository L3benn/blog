---
import { getPostType, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
	featured?: boolean;
	index?: number;
}
const { post, featured = false, index = 0 } = Astro.props;
const { title, description, pubDate, tags = [], thumbnail } = post.data;
const type = getPostType(tags);
---

<a
	class:list={['card', 'post-card', { featured }]}
	href={`/blog/${post.id}/`}
	data-tags={tags.join(' ')}
	data-reveal
	style={`--i:${index % 3}`}
>
	<div class="thumb">
		{thumbnail && <img src={thumbnail} alt="" loading={featured ? 'eager' : 'lazy'} decoding="async" />}
	</div>
	<div class="body">
		<div class="meta">
			<span class:list={['badge', type.badgeClass]}>{type.label}</span>
			<FormattedDate date={pubDate} />
		</div>
		<h3>{title}</h3>
		{description && <p class="desc">{description}</p>}
		<div class="foot">
			<div class="tags">
				{tags.slice(0, featured ? 5 : 3).map((tag) => <span class="tag">{tag}</span>)}
			</div>
			<span class="arrow" aria-hidden="true">&rarr;</span>
		</div>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
	}
	.thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-2);
		border-bottom: 1px solid var(--line);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.85) brightness(0.9);
		transition: transform 0.9s var(--ease), filter 0.5s;
	}
	.post-card:hover .thumb img {
		transform: scale(1.045);
		filter: none;
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.25rem 1.35rem 1.2rem;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.85rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--faint);
	}
	h3 {
		margin: 0 0 0.45rem;
		font-size: 1.1rem;
		line-height: 1.3;
		transition: color 0.2s;
	}
	.desc {
		margin: 0 0 1.2rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		min-width: 0;
	}
	.arrow {
		color: var(--faint);
		transition: transform 0.25s var(--ease), color 0.2s;
	}
	.post-card:hover .arrow {
		color: var(--accent);
	}

	/* featured: image beside text on wide screens */
	@media (min-width: 861px) {
		.featured {
			flex-direction: row;
			grid-column: 1 / -1;
		}
		.featured .thumb {
			flex: 0 0 56%;
			aspect-ratio: auto;
			min-height: 340px;
			border-bottom: none;
			border-right: 1px solid var(--line);
		}
		.featured .body {
			justify-content: center;
			padding: 2.5rem;
		}
		.featured h3 {
			font-size: 1.75rem;
			line-height: 1.15;
			letter-spacing: -0.035em;
		}
		.featured .desc {
			font-size: 1rem;
			-webkit-line-clamp: 3;
			line-clamp: 3;
		}
		.featured .foot {
			margin-top: 1rem;
		}
	}
</style>
