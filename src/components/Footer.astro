---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL, SITE_TITLE } from '../consts';
import SiteEffects from './SiteEffects.astro';

const year = new Date().getFullYear();

// Kakashi lines, one shown at a time.
const quotes = [
	'Those who break the rules are scum, but those who abandon their friends are worse than scum.',
	'Look underneath the underneath.',
	'Sorry I’m late. I got lost on the path of life.',
	'I’ll protect my comrades, even at the cost of my life.',
];
---

<footer>
	<div class="inner">
		<div class="top">
			<div class="brand">
				<a href="/" class="logo">{SITE_TITLE}<span>.</span></a>
				<figure class="quote-box">
					<blockquote class="quote serif" data-quotes={JSON.stringify(quotes)}>&ldquo;{quotes[0]}&rdquo;</blockquote>
					<figcaption>&mdash; Kakashi Hatake</figcaption>
				</figure>
			</div>
			<nav class="col" aria-label="Site">
				<h2>Site</h2>
				<a href="/writeups">Writeups</a>
				<a href="/cheatsheets">Cheatsheets</a>
				<a href="/certs">Certifications</a>
				<a href="/about">About</a>
			</nav>
			<nav class="col" aria-label="Elsewhere">
				<h2>Elsewhere</h2>
				<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
				<a href={MEDIUM_URL} target="_blank" rel="noopener">Medium</a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
				<a href={`mailto:${EMAIL}`}>Email</a>
			</nav>
			<nav class="col" aria-label="More">
				<h2>More</h2>
				<a href="/search">Full-text search</a>
				<a href="/rss.xml">RSS feed</a>
				<a href="/CV.pdf" target="_blank">Download CV</a>
			</nav>
		</div>
		<div class="bottom">
			<p>&copy; {year} Chiheb Mahfoudh</p>
			<p class="keys">
				<span><kbd>Ctrl</kbd> <kbd>K</kbd> search</span>
				<span><kbd>S</kbd> Sharingan</span>
			</p>
		</div>
	</div>
</footer>
<SiteEffects />

<script>
	// Cycle through Kakashi's lines.
	const q = document.querySelector<HTMLElement>('[data-quotes]');
	if (q) {
		const lines: string[] = JSON.parse(q.dataset.quotes || '[]');
		let i = Math.floor(Math.random() * lines.length);
		const show = () => (q.textContent = `\u201C${lines[i]}\u201D`);
		show();
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches)
			setInterval(() => {
				if (document.hidden) return;
				q.classList.add('swap');
				setTimeout(() => {
					i = (i + 1) % lines.length;
					show();
					q.classList.remove('swap');
				}, 600);
			}, 9000);
	}
</script>

<style>
	footer {
		margin-top: 4rem;
		padding: 0 var(--gutter);
		border-top: 1px solid var(--line);
		background: linear-gradient(rgba(255, 255, 255, 0.015), transparent);
	}
	.inner {
		max-width: var(--wrap);
		margin: 0 auto;
		padding: 3.5rem 0 2rem;
	}
	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
		gap: 2.5rem;
	}
	.logo {
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--text-strong);
	}
	.logo span {
		color: var(--accent);
	}
	.quote-box {
		margin: 1rem 0 0;
	}
	.quote-box figcaption {
		margin-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.quote {
		max-width: 30ch;
		min-height: 4.2em;
		margin: 0;
		transition: opacity 0.6s, filter 0.6s;
		font-size: 1.12rem;
		line-height: 1.4;
		color: var(--muted);
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.col h2 {
		margin: 0 0 0.4rem;
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.col a {
		width: fit-content;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.col a:hover {
		color: var(--text-strong);
	}
	.bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.8rem 2rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.8rem;
		color: var(--faint);
	}
	.bottom p {
		margin: 0;
	}
	.keys {
		display: flex;
		gap: 1.4rem;
	}
	.quote.swap {
		opacity: 0;
		filter: blur(4px);
	}
	@media (max-width: 760px) {
		.top {
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1.5rem;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
	@media (hover: none) {
		.keys {
			display: none;
		}
	}
</style>
