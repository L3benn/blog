---
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="links">
			<a href="/">Home</a>
			<a href="/writeups">Writeups</a>
			<a href="/cheatsheets">Cheatsheets</a>
			<a href="/certs">Certifications</a>
			<a href="/about">About</a>
		</div>
		<p class="copy">&copy; {today.getFullYear()} Chiheb Mahfoudh. All rights reserved.</p>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 2.5em;
		text-align: center;
		font-size: 0.85em;
	}
	.inner {
		max-width: 920px;
		margin: 0 auto;
	}
	.links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.3em;
		margin-bottom: 1em;
	}
	.links a {
		padding: 0.4em 0.8em;
		color: #5a8a7a;
		text-decoration: none;
		border-radius: 0;
		font-size: 0.9em;
		transition: all 0.2s;
	}
	.links a:hover {
		color: #8ab8a8;
		background: rgba(79, 196, 184, 0.06);
	}
	.copy {
		color: #5a8a7a;
		margin: 0;
		font-size: 0.85em;
	}
</style>
