---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Sharingan from './Sharingan.astro';
---

<header class="site-header" id="site-header">
	<div class="bar">
		<a href="/" class="logo" aria-label={`${SITE_TITLE} — home`}>{SITE_TITLE}<span>.</span></a>

		<nav class="nav-links" id="nav-links" aria-label="Main">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/writeups">Writeups</HeaderLink>
			<HeaderLink href="/cheatsheets">Cheatsheets</HeaderLink>
			<HeaderLink href="/certs">Certifications</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>

		<div class="tools">
			<button type="button" class="search-btn" data-palette-open aria-label="Search (Ctrl+K)">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
					><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path
						d="M15.5 15.5L20.5 20.5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path></svg
				>
				<span>Search</span>
				<kbd>Ctrl K</kbd>
			</button>
			<button type="button" class="mode-btn" data-mode-toggle aria-pressed="false" aria-label="Toggle Sharingan mode" title="Reveal the Sharingan">
				<Sharingan size={22} />
			</button>
			<button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
				<span></span><span></span>
			</button>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		top: 14px;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 0 var(--gutter);
		view-transition-name: site-header;
	}
	.bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1rem;
		max-width: var(--wrap);
		margin: 0 auto;
		padding: 0.45rem 0.5rem 0.45rem 1.25rem;
		background: rgba(12, 13, 17, 0.6);
		border: 1px solid var(--line);
		border-radius: 999px;
		backdrop-filter: blur(18px) saturate(160%);
		-webkit-backdrop-filter: blur(18px) saturate(160%);
		transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
	}
	.site-header.scrolled .bar {
		background: rgba(10, 11, 14, 0.82);
		border-color: var(--line-strong);
		box-shadow: 0 12px 40px -16px rgba(0, 0, 0, 0.9);
	}
	.logo {
		font-size: 1.02rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--text-strong);
	}
	.logo span {
		color: var(--accent);
	}
	.nav-links {
		display: flex;
		gap: 0.15rem;
		margin: 0 auto;
	}
	.nav-links :global(a) {
		padding: 0.42rem 0.85rem;
		font-size: 0.875rem;
		font-weight: 450;
		color: var(--muted);
		border-radius: 999px;
		white-space: nowrap;
		transition: color 0.2s, background 0.2s;
	}
	.nav-links :global(a:hover) {
		color: var(--text-strong);
	}
	.nav-links :global(a.active) {
		color: var(--text-strong);
		background: rgba(255, 255, 255, 0.08);
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.tools button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: 1px solid transparent;
		border-radius: 999px;
		transition: color 0.2s, background 0.2s, border-color 0.2s, box-shadow 0.3s;
	}
	.search-btn {
		gap: 0.5rem;
		padding: 0.38rem 0.5rem 0.38rem 0.75rem;
		font-size: 0.82rem;
		color: var(--muted);
		background: rgba(255, 255, 255, 0.04) !important;
		border-color: var(--line) !important;
	}
	.search-btn:hover {
		color: var(--text-strong);
		border-color: var(--line-strong) !important;
	}
	.search-btn kbd {
		border-radius: 999px;
		padding: 0.1em 0.6em;
	}
	.mode-btn {
		width: 36px;
		height: 36px;
	}
	.mode-btn:hover {
		background: rgba(255, 255, 255, 0.06);
	}
	/* covered eye in Chidori mode, revealed with spinning tomoe in Sharingan mode */
	.mode-btn :global(.iris) {
		fill: #454b58;
		transition: fill 0.4s;
	}
	.mode-btn :global(.tomoe) {
		transition: transform 0.9s var(--ease);
	}
	.mode-btn[aria-pressed='true'] {
		box-shadow: 0 0 18px rgba(255, 90, 95, 0.55);
	}
	.mode-btn[aria-pressed='true'] :global(.iris) {
		fill: #e5383b;
	}
	.mode-btn[aria-pressed='true'] :global(.tomoe) {
		transform: rotate(360deg);
	}
	.menu-btn {
		display: none !important;
		flex-direction: column;
		gap: 5px;
		width: 36px;
		height: 36px;
	}
	.menu-btn span {
		width: 16px;
		height: 1.5px;
		background: var(--text-strong);
		transition: transform 0.3s var(--ease);
	}
	.menu-btn[aria-expanded='true'] span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}
	.menu-btn[aria-expanded='true'] span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	@media (max-width: 860px) {
		.bar {
			padding-left: 1.1rem;
		}
		.logo {
			margin-right: auto;
		}
		.search-btn span,
		.search-btn kbd {
			display: none;
		}
		.search-btn {
			width: 36px;
			height: 36px;
			padding: 0;
		}
		.menu-btn {
			display: inline-flex !important;
		}
		.nav-links {
			position: absolute;
			top: calc(100% + 8px);
			left: 0;
			right: 0;
			flex-direction: column;
			gap: 0;
			margin: 0;
			padding: 0.5rem;
			background: #0d0e12;
			border: 1px solid var(--line-strong);
			border-radius: 20px;
			box-shadow: 0 24px 60px -20px #000;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-6px);
			transition: opacity 0.25s, transform 0.25s var(--ease), visibility 0.25s;
		}
		.site-header.open .nav-links {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
		.nav-links :global(a) {
			padding: 0.8rem 1rem;
			font-size: 1rem;
			border-radius: 14px;
		}
	}
</style>
