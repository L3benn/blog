---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL, EMAIL } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const certs = await getCollection('certs');
const cheatsheets = await getCollection('cheatsheets');

function getPostType(tags: string[] = []): { label: string; badgeClass: string } {
	if (tags.includes('ctf')) return { label: 'CTF', badgeClass: 'badge-writeup' };
	if (tags.includes('htb')) return { label: 'HTB', badgeClass: 'badge-writeup' };
	if (tags.includes('cert-journey')) return { label: 'Journey', badgeClass: 'badge-cert' };
	return { label: 'Writeup', badgeClass: 'badge-article' };
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3em;
				padding: 2.5em 0 3.5em;
			}
			.avatar {
				width: 120px;
				height: 120px;
				border-radius: 0;
				object-fit: cover;
				flex-shrink: 0;
			}
			.hero-text h1 {
				margin: 0 0 0.15em;
				font-size: 2.2em;
				letter-spacing: -0.03em;
			}
			.hero-text .tagline {
				color: #4fc4b8;
				font-size: 1em;
				margin: 0 0 0.6em;
				font-weight: 500;
			}
			.hero-text .bio {
				color: #8ab8a8;
				font-size: 0.9em;
				line-height: 1.7;
				margin: 0;
				max-width: 540px;
			}
			.hero-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-top: 1em;
			}
			.hero-links a {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.3em 0.8em;
				border-radius: 0;
				font-size: 0.85em;
				font-weight: 500;
				text-decoration: none;
				color: #8ab8a8;
			}
			.hero-links a:hover {
				color: #e0ede6;
			}

			.stats-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1em;
				margin-bottom: 3.5em;
			}
			.stat-card {
				padding: 1.4em 1.2em;
				text-align: center;
			}
			.stat-number {
				font-size: 2em;
				font-weight: 700;
				color: #4fc4b8;
				display: block;
				line-height: 1.2;
			}
			.stat-label {
				color: #8ab8a8;
				font-size: 0.8em;
				margin-top: 0.3em;
				display: block;
				font-weight: 500;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
				gap: 1.2em;
				margin-bottom: 2em;
			}
			.post-card {
				border-radius: 0;
				overflow: hidden;
			}
			.post-card:hover {
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.post-card .thumb {
				width: 100%;
				height: 220px;
				object-fit: cover;
				object-position: center;
				display: block;
				background: #222222;
			}
			.post-card .body {
				padding: 1.2em 1.3em;
			}
			.post-card .top-row {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.5em;
			}
			.post-card h3 {
				margin: 0 0 0.35em;
				font-size: 1.05em;
				color: #e0ede6;
				line-height: 1.35;
				transition: color 0.2s;
			}
			.post-card a:hover h3 {
				color: #4fc4b8;
			}
			.post-card .meta {
				color: #8ab8a8;
				font-size: 0.78em;
				margin-bottom: 0.5em;
			}
			.post-card .desc {
				color: #8ab8a8;
				font-size: 0.83em;
				line-height: 1.55;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card .tags {
				display: flex;
				gap: 0.35em;
				flex-wrap: wrap;
				margin-top: 0.7em;
			}

			.view-all-wrap {
				text-align: center;
				margin-bottom: 3em;
			}

			@media (max-width: 600px) {
				.hero {
					flex-direction: column;
					text-align: center;
					gap: 1.5em;
					padding: 1.5em 0 2em;
				}
				.hero-text .bio {
					max-width: 100%;
				}
				.hero-links {
					justify-content: center;
				}
				.post-grid {
					grid-template-columns: 1fr;
				}
				.stats-grid {
					gap: 0.7em;
				}
				.stat-card {
					padding: 1em 0.8em;
				}
				.explore-grid {
					grid-template-columns: 1fr 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<img class="avatar" src="/kakashi.jpg" alt="l3benn" />
				<div class="hero-text">
					<h1>Chiheb Mahfoudh</h1>
					<p class="tagline">Security researcher &bull; CTF enthusiast &bull; Pentest student</p>
					<p class="bio">
						Breaking things, learning, and sharing writeups on penetration testing, AD security, CTF challenges, and red teaming.
					</p>
					<div class="hero-links">
						<a href={GITHUB_URL} target="_blank">GitHub</a>
						<a href={MEDIUM_URL} target="_blank">Medium</a>
						<a href={LINKEDIN_URL} target="_blank">LinkedIn</a>
						<a href="/about">About &rarr;</a>
					</div>
				</div>
			</section>

			<div class="stats-grid">
				<div class="stat-card">
					<span class="stat-number">{posts.length}</span>
					<span class="stat-label">Writeups</span>
				</div>
				<div class="stat-card">
					<span class="stat-number">{certs.length}</span>
					<span class="stat-label">Certifications</span>
				</div>
				<div class="stat-card">
					<span class="stat-number">{cheatsheets.length}</span>
					<span class="stat-label">Cheatsheets</span>
				</div>
			</div>

			<section>
				<h2 class="section-title">Latest Writeups</h2>
				{posts.length > 0 ? (
					<>
						<div class="post-grid">
							{posts.map((post) => {
								const type = getPostType(post.data.tags);
								return (
									<div class="post-card">
										<a href={`/blog/${post.id}/`}>
											{post.data.thumbnail && <img class="thumb" src={post.data.thumbnail} alt="" loading="lazy" />}
											<div class="body">
												<div class="top-row">
													<span class={"badge " + type.badgeClass}>{type.label}</span>
													<span class="meta"><FormattedDate date={post.data.pubDate} /></span>
												</div>
												<h3>{post.data.title}</h3>
												{post.data.description && <p class="desc">{post.data.description}</p>}
												{post.data.tags && post.data.tags.length > 0 && (
													<div class="tags">
														{post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
													</div>
												)}
											</div>
										</a>
									</div>
								);
							})}
						</div>
						<div class="view-all-wrap">
							<a href="/writeups" class="btn">View all writeups &rarr;</a>
						</div>
					</>
				) : (
					<p>No writeups yet. Check back soon!</p>
				)}
			</section>

		</main>
		<Footer />
	</body>
</html>
