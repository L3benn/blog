---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import path from 'path';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sheets = (await getCollection('cheatsheets')).sort(
	(a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
const certs = (await getCollection('certs')).sort(
	(a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf(),
);

function stripMd(text: string): string {
	return text
		.replace(/---[\s\S]*?---/, '')
		.replace(/<[^>]*>/g, '')
		.replace(/!\[.*?\]\(.*?\)/g, '')
		.replace(/\[([^\]]*)\]\(.*?\)/g, '$1')
		.replace(/[#*`>|_~-]/g, ' ')
		.replace(/["']/g, '')
		.replace(/\s+/g, ' ')
		.trim()
		.toLowerCase();
}

const contentDir = path.resolve('./src/content');

const index: {
	title: string;
	desc: string;
	body: string;
	slug: string;
	type: string;
	date: string;
}[] = [];

for (const post of posts) {
	const filePath = path.join(contentDir, 'blog', post.id + '.md');
	const body = fs.existsSync(filePath) ? stripMd(fs.readFileSync(filePath, 'utf-8')) : '';
	index.push({
		title: post.data.title,
		desc: post.data.description,
		body,
		slug: `/blog/${post.id}/`,
		type: 'Writeup',
		date: post.data.pubDate.toISOString().slice(0, 10),
	});
}
for (const sheet of sheets) {
	const filePath = path.join(contentDir, 'cheatsheets', sheet.id + '.md');
	const body = fs.existsSync(filePath) ? stripMd(fs.readFileSync(filePath, 'utf-8')) : '';
	index.push({
		title: sheet.data.title,
		desc: sheet.data.description,
		body,
		slug: `/cheatsheets/${sheet.id}/`,
		type: 'Cheatsheet',
		date: '',
	});
}
for (const cert of certs) {
	index.push({
		title: cert.data.title,
		desc: cert.data.description ?? '',
		body: (cert.data.skills ?? []).join(' ').toLowerCase(),
		slug: '/certs/',
		type: 'Certification',
		date: cert.data.dateEarned.toISOString().slice(0, 10),
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search - ${SITE_TITLE}`} description="Full-text search across all content" />
		<style>
			.search-field {
				position: relative;
				margin-bottom: 1.5rem;
			}
			.search-field svg {
				position: absolute;
				top: 50%;
				left: 1.3rem;
				color: var(--muted);
				transform: translateY(-50%);
				pointer-events: none;
			}
			.search-box {
				width: 100%;
				padding: 1.1rem 1.3rem 1.1rem 3.4rem;
				font: inherit;
				font-size: 1.1rem;
				color: var(--text-strong);
				background: var(--card-bg);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				outline: none;
				transition: border-color 0.2s, box-shadow 0.3s;
			}
			.search-box:focus {
				border-color: rgba(var(--accent-rgb), 0.55);
				box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.1);
			}
			.search-box::placeholder {
				color: var(--faint);
			}
			.result-count {
				margin-bottom: 0.6rem;
				font-family: var(--mono);
				font-size: 0.72rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--faint);
			}
			.result-list {
				margin: 0;
				padding: 0;
				list-style: none;
				border-top: 1px solid var(--line);
			}
			.result-item {
				border-bottom: 1px solid var(--line);
			}
			.result-item a {
				display: block;
				padding: 1.3rem 0.4rem;
				color: inherit;
				transition: padding 0.35s var(--ease), background 0.3s;
			}
			.result-item a:hover {
				padding-left: 1.1rem;
				background: rgba(255, 255, 255, 0.025);
			}
			.result-item h3 {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.7rem;
				margin: 0 0 0.35rem;
				font-size: 1.12rem;
			}
			.result-type {
				font-family: var(--mono);
				font-size: 0.62rem;
				font-weight: 500;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				padding: 0.25em 0.7em;
				color: var(--accent-light);
				background: rgba(var(--accent-rgb), 0.1);
				border: 1px solid rgba(var(--accent-rgb), 0.22);
				border-radius: 999px;
			}
			.result-meta {
				font-family: var(--mono);
				font-size: 0.72rem;
				color: var(--faint);
			}
			.result-desc {
				margin: 0.35rem 0 0;
				font-size: 0.92rem;
				color: var(--muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<PageHeader eyebrow="Search" lead="Full-text search across every writeup, cheatsheet and certification.">
				Find <em>anything.</em>
			</PageHeader>
			<div id="search-app">
				<div class="search-field">
					<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
						><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path
							d="M15.5 15.5L20.5 20.5"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"></path></svg
					>
					<input type="text" id="search-input" class="search-box" placeholder="Try “kerberos”, “union select”, “ssrf”…" aria-label="Search" autofocus />
				</div>
				<div id="result-count" class="result-count">{index.length} items</div>
				<ul id="result-list" class="result-list">
					{index.map((item, i) => (
						<li class="result-item" data-idx={i}>
							<a href={item.slug}>
								<h3><span class="result-type">{item.type}</span>{item.title}</h3>
								{item.date && <div class="result-meta">{item.date}</div>}
								<p class="result-desc">{item.desc}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		</main>
		<Footer />

		<script id="search-data" type="application/json" set:html={JSON.stringify(index)}></script>
		<script>
			const input = document.getElementById('search-input');
			const list = document.getElementById('result-list');
			const count = document.getElementById('result-count');
			const items = Array.from(list.querySelectorAll('.result-item'));
			const data = JSON.parse(document.getElementById('search-data').textContent);

			input.addEventListener('input', () => {
				const q = input.value.toLowerCase().trim();
				let visible = 0;
				for (let i = 0; i < items.length; i++) {
					const d = data[i];
					const match = q === '' ||
						d.title.toLowerCase().includes(q) ||
						d.desc.toLowerCase().includes(q) ||
						d.body.includes(q);
					items[i].style.display = match ? '' : 'none';
					if (match) {
						visible++;
					}
				}
				count.textContent = q ? `${visible} of ${items.length} items` : `${items.length} items`;
			});
		</script>
	</body>
</html>
