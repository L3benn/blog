---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL, SITE_TITLE } from '../consts';

const skills = [
	'Offensive Security & Penetration Testing',
	'Active Directory & Kerberos Attacks',
	'Web Application Exploitation',
	'Red Teaming & Adversary Simulation',
	'Network & Infrastructure Security',
	'Vulnerability Assessment & Reporting',
	'CTF Challenge Authoring',
	'DevSecOps & CI/CD Security',
];
const interests = [
	'Vulnerability Research',
	'Reverse Engineering',
	'Active Directory Security',
	'Red Teaming',
	'CTF Competitions',
];
const links = [
	{ label: 'GitHub', value: 'l3benn', href: GITHUB_URL },
	{ label: 'Medium', value: 'Articles', href: MEDIUM_URL },
	{ label: 'LinkedIn', value: 'Profile', href: LINKEDIN_URL },
	{ label: 'Email', value: EMAIL, href: `mailto:${EMAIL}` },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="About Chiheb Mahfoudh" />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader eyebrow="About">
				Chiheb Mahfoudh, <em>offensive security.</em>
			</PageHeader>

			<div class="about">
				<aside class="card profile" data-reveal>
					<img src="/kakashi.jpg" alt="" width="96" height="96" />
					<h2>Chiheb Mahfoudh</h2>
					<p class="role">Cybersecurity student &middot; l3benn</p>
					<div class="certs">
						<span class="badge">HTB CPTS</span>
						<span class="badge">HTB CWES</span>
						<span class="badge">CRTP</span>
					</div>
					<ul class="links">
						{links.map((l) => (
							<li>
								<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
									<span>{l.label}</span>
									<span class="v">{l.value}</span>
								</a>
							</li>
						))}
					</ul>
					<a class="btn cv" href="/CV.pdf" target="_blank">Download CV <span class="arrow" aria-hidden="true">&rarr;</span></a>
				</aside>

				<div class="story">
					<div class="prose" data-reveal>
						<p class="intro">
							I'm Chiheb Mahfoudh, a second-year Computer Networks and Telecommunications student at ISETCOM with a strong
							passion for Offensive Security, Penetration Testing, Active Directory security, and Red Teaming.
						</p>
						<p>
							I hold industry-recognized certifications including <strong>HTB CPTS</strong>,{' '}
							<strong>HTB CWES</strong>, and <strong>CRTP</strong>, with hands-on experience gained through CTF competitions,
							challenge authoring, enterprise Active Directory labs, and DevSecOps internship experience integrating
							security into CI/CD pipelines.
						</p>
						<p>
							This blog is where I share writeups, certification journey posts, and cheatsheets covering the topics I work
							on. I also publish on <a href={GITHUB_URL}>GitHub</a> and <a href={MEDIUM_URL}>Medium</a>.
						</p>
					</div>

					<section data-reveal>
						<p class="eyebrow">Skills &amp; focus areas</p>
						<ol class="skill-list">
							{skills.map((s, i) => (
								<li>
									<span class="idx">{String(i + 1).padStart(2, '0')}</span>
									{s}
								</li>
							))}
						</ol>
					</section>

					<section data-reveal>
						<p class="eyebrow">Interests</p>
						<div class="interests">
							{interests.map((s) => <span class="tag">{s}</span>)}
						</div>
					</section>
				</div>
			</div>
		</main>
		<Footer />
		<style>
			.about {
				display: grid;
				grid-template-columns: 340px minmax(0, 1fr);
				gap: 4rem;
				align-items: start;
			}
			.profile {
				position: sticky;
				top: 6.5rem;
				padding: 1.8rem;
			}
			.profile img {
				display: block;
				width: 96px;
				height: 96px;
				margin-bottom: 1.3rem;
				object-fit: cover;
				border: 1px solid var(--line-strong);
				border-radius: 50%;
				box-shadow: 0 0 0 5px rgba(var(--accent-rgb), 0.1);
			}
			.profile h2 {
				margin: 0 0 0.2rem;
				font-size: 1.3rem;
			}
			.role {
				margin: 0 0 1.1rem;
				font-size: 0.9rem;
				color: var(--muted);
			}
			.certs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-bottom: 1.4rem;
			}
			.links {
				margin: 0 0 1.5rem;
				padding: 0;
				list-style: none;
				border-top: 1px solid var(--line);
			}
			.links a {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.75rem 0;
				font-size: 0.88rem;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
			}
			.links .v {
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				color: var(--text-strong);
				transition: color 0.2s;
			}
			.links a:hover .v {
				color: var(--accent-light);
			}
			.cv {
				width: 100%;
				justify-content: center;
			}
			.story {
				display: grid;
				gap: 3.5rem;
			}
			.intro {
				font-size: 1.45rem;
				line-height: 1.45;
				letter-spacing: -0.02em;
				color: var(--text-strong);
			}
			.prose p:last-child {
				margin-bottom: 0;
			}
			.skill-list {
				margin: 0;
				padding: 0;
				list-style: none;
				border-top: 1px solid var(--line);
			}
			.skill-list li {
				display: flex;
				align-items: baseline;
				gap: 1.4rem;
				padding: 0.95rem 0.3rem;
				font-size: 1.05rem;
				color: var(--text-strong);
				border-bottom: 1px solid var(--line);
				transition: padding 0.35s var(--ease), background 0.3s;
			}
			.skill-list li:hover {
				padding-left: 1rem;
				background: rgba(255, 255, 255, 0.025);
			}
			.idx {
				font-family: var(--mono);
				font-size: 0.72rem;
				color: var(--accent);
			}
			.interests {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.interests .tag {
				padding: 0.45em 1em;
				font-size: 0.8rem;
			}
			@media (max-width: 900px) {
				.about {
					grid-template-columns: 1fr;
					gap: 3rem;
				}
				.profile {
					position: static;
				}
				.intro {
					font-size: 1.2rem;
				}
			}
		</style>
	</body>
</html>
