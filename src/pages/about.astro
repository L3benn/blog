---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, LINKEDIN_URL, MEDIUM_URL, EMAIL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="About Chiheb Mahfoudh" />
		<style>
			.about-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2em;
				margin-top: 1.5em;
			}
			.about-card {
				background: rgba(235,232,222,0.78);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 12px;
				padding: 1.5em;
			}
			.about-card h2 {
				margin: 0 0 0.8em;
				font-size: 1.15em;
				color: #0f4f53;
			}
			.about-card ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.about-card li {
				padding: 0.4em 0;
				color: #3a6b65;
				font-size: 0.9em;
				line-height: 1.5;
			}
			.about-card li::before {
				content: '>';
				color: #2e7d79;
				font-weight: 700;
				margin-right: 0.5em;
			}
			.about-card a {
				color: #2e7d79;
				font-weight: 600;
			}
			.about-card a:hover {
				color: #1f6666;
			}
			.cert-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 0.5em;
			}
			.cert-badge {
				background: rgba(191, 216, 194, 0.4);
				color: #1f6666;
				padding: 0.25em 0.7em;
				border-radius: 6px;
				font-size: 0.8em;
				font-weight: 600;
			}
			.social-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8em;
				margin-top: 1.5em;
			}
			.social-links a {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.6em 1.2em;
				background: rgba(235,232,222,0.78);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 8px;
				color: #2e7d79;
				text-decoration: none;
				font-size: 0.85em;
				font-weight: 600;
				transition: all 0.2s;
			}
			.social-links a:hover {
				background: #2e7d79;
				color: #fff;
			}
			@media (max-width: 700px) {
				.about-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>About Me</h1>
			<p>
				I'm Chiheb Mahfoudh, a Second-year Computer Networks and Telecommunications student
				at ISETCOM with a strong passion for Offensive Security, Penetration Testing,
				Active Directory security, and Red Teaming.
			</p>
			<p>
				I hold industry-recognized certifications including <strong>HTB CPTS</strong>,
				<strong>HTB CWES</strong>, and <strong>CRTP</strong>, with hands-on experience
				gained through CTF competitions, challenge authoring, enterprise Active Directory labs,
				and DevSecOps internship experience integrating security into CI/CD pipelines.
			</p>
			<p>
				This blog is where I share writeups, certification journey posts, and cheatsheets
				covering the topics I work on. I also publish on
				<a href={GITHUB_URL}>GitHub</a> and <a href={MEDIUM_URL}>Medium</a>.
			</p>

			<div class="about-grid">
				<div class="about-card">
					<h2>Skills & Focus Areas</h2>
					<ul>
						<li>Offensive Security & Penetration Testing</li>
						<li>Active Directory & Kerberos Attacks</li>
						<li>Web Application Exploitation</li>
						<li>Red Teaming & Adversary Simulation</li>
						<li>Network & Infrastructure Security</li>
						<li>Vulnerability Assessment & Reporting</li>
						<li>CTF Challenge Authoring</li>
						<li>DevSecOps & CI/CD Security</li>
					</ul>
				</div>

				<div class="about-card">
					<h2>Certifications</h2>
					<div class="cert-list">
						<span class="cert-badge">HTB CPTS</span>
						<span class="cert-badge">HTB CWES</span>
						<span class="cert-badge">CRTP</span>
					</div>
					<h2 style="margin-top:3em">Interests</h2>
					<ul>
						<li>Vulnerability Research</li>
						<li>Reverse Engineering</li>
						<li>Active Directory Security</li>
						<li>Red Teaming</li>
						<li>CTF Competitions</li>
					</ul>
				</div>
			</div>

			<h2>Where to find me</h2>
			<div class="social-links">
				<a href={GITHUB_URL} target="_blank">GitHub (l3benn)</a>
				<a href={MEDIUM_URL} target="_blank">Medium</a>
				<a href={LINKEDIN_URL} target="_blank">LinkedIn</a>
				<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
				<a href="/CV.pdf" target="_blank">Download CV</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
