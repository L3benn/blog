---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const words = (post.body ?? '').replace(/```[\s\S]*?```/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const link = (p?: CollectionEntry<'blog'>) => p && { title: p.data.title, href: `/blog/${p.id}/` };
---

<BlogPost {...post.data} headings={headings} minutes={minutes} newer={link(newer)} older={link(older)}>
	<Content />
</BlogPost>
