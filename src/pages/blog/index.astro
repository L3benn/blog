---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writeups - ${SITE_TITLE}`} description="Security writeups, CTF solutions, and exploit writeups" />
		<style>
			.layout {
				display: grid;
				grid-template-columns: 1fr 260px;
				gap: 2em;
				align-items: start;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				padding: 1.2em 0;
				border-bottom: 1px solid rgba(200,218,195,0.4);
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-item a {
				text-decoration: none;
				color: inherit;
				display: flex;
				gap: 1.2em;
				align-items: flex-start;
			}
			.post-item .thumb {
				width: 180px;
				height: 110px;
				border-radius: 10px;
				object-fit: cover;
				flex-shrink: 0;
				background: #d8e4c7;
			}
			.post-item h2 {
				margin: 0 0 0.3em;
				font-size: 1.2em;
				color: #0f4f53;
				transition: color 0.2s;
			}
			.post-item a:hover h2 {
				color: #2e7d79;
			}
			.meta {
				color: #5c9a91;
				font-size: 0.8em;
				margin-bottom: 0.4em;
			}
			.description {
				color: #3a6b65;
				margin: 0 0 0.5em;
				font-size: 0.85em;
				line-height: 1.5;
			}
			.tags {
				display: flex;
				gap: 0.4em;
				flex-wrap: wrap;
			}
			.tag {
				background: rgba(191, 216, 194, 0.4);
				color: #1f6666;
				padding: 0.15em 0.5em;
				border-radius: 4px;
				font-size: 0.72em;
			}
			.empty-state {
				text-align: center;
				padding: 4em 1em;
				color: #5c9a91;
			}
			.external-sources {
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgba(200,218,195,0.5);
			}
			.external-sources h2 {
				margin-bottom: 1em;
			}
			.external-sources ul {
				list-style: none;
				padding: 0;
			}
			.external-sources li {
				margin-bottom: 0.5em;
			}
			.external-sources a {
				color: #2e7d79;
				font-weight: 600;
			}
			@media (max-width: 820px) {
				.layout {
					grid-template-columns: 1fr;
				}
				.post-item a {
					flex-direction: column;
				}
				.post-item .thumb {
					width: 100%;
					height: 160px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Writeups</h1>
			<p>Security research, CTF solutions, and exploit writeups.</p>

			<div class="layout">
				<div>
					{posts.length > 0 ? (
						<ul class="post-list">
							{posts.map((post) => (
								<li class="post-item">
									<a href={`/blog/${post.id}/`}>
										{post.data.thumbnail && <img class="thumb" src={post.data.thumbnail} alt="" loading="lazy" />}
										<div>
											<h2>{post.data.title}</h2>
											<div class="meta">
												<FormattedDate date={post.data.pubDate} />
											</div>
											<p class="description">{post.data.description}</p>
											{post.data.tags && post.data.tags.length > 0 && (
												<div class="tags">
													{post.data.tags.map((tag) => (
														<span class="tag">{tag}</span>
													))}
												</div>
											)}
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty-state">
							<p>No writeups yet.</p>
						</div>
					)}

					<div class="external-sources">
						<h2>External writeups</h2>
						<p>I also publish writeups on these platforms:</p>
						<ul>
						<li><a href={GITHUB_URL} target="_blank">GitHub /l3benn</a></li>
						<li><a href={MEDIUM_URL} target="_blank">Medium</a></li>
						<li><a href={LINKEDIN_URL} target="_blank">LinkedIn</a></li>
						</ul>
					</div>
				</div>
				<Sidebar posts={posts} currentPath="/blog/" />
			</div>
		</main>
		<Footer />
	</body>
</html>
