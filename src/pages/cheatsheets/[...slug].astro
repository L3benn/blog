---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const sheets = await getCollection('cheatsheets');
	return sheets.map((sheet) => ({
		params: { slug: sheet.id },
		props: sheet,
	}));
}
type Props = CollectionEntry<'cheatsheets'>;

const sheet = Astro.props;
const { Content, headings } = await render(sheet);
---

<BlogPost
	title={sheet.data.title}
	description={sheet.data.description}
	pubDate={sheet.data.pubDate}
	tags={sheet.data.category ? [sheet.data.category] : []}
	headings={headings}
	back={{ href: '/cheatsheets', label: 'Cheatsheets' }}
>
	<Content />
</BlogPost>
