---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';

const sheets = (await getCollection('cheatsheets')).sort(
	(a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cheatsheets - ${SITE_TITLE}`} description="Security cheatsheets and quick references" />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader eyebrow="Cheatsheets" lead="Quick references and payload tables for security tools and techniques.">
				Reference, <em>at speed.</em>
			</PageHeader>

			{sheets.length > 0 ? (
				<div class="sheets">
					{sheets.map((sheet, i) => (
						<a class="card sheet" href={`/cheatsheets/${sheet.id}/`} data-reveal style={`--i:${i % 3}`}>
							<div class="top">
								{sheet.data.category && <span class="badge">{sheet.data.category}</span>}
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
							</div>
							<h2>{sheet.data.title}</h2>
							<p>{sheet.data.description}</p>
							<span class="open">Open cheatsheet <span class="arrow" aria-hidden="true">&rarr;</span></span>
						</a>
					))}
				</div>
			) : (
				<div class="empty-state">
					<p>No cheatsheets yet.</p>
				</div>
			)}
		</main>
		<Footer />
		<style>
			.sheets {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
			}
			.sheet {
				display: flex;
				flex-direction: column;
				min-height: 260px;
				padding: 1.6rem 1.7rem;
			}
			.top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 2.6rem;
			}
			.num {
				font-family: var(--mono);
				font-size: 0.75rem;
				color: var(--faint);
			}
			.sheet h2 {
				margin: 0 0 0.5rem;
				font-size: 1.3rem;
			}
			.sheet p {
				margin: 0 0 1.6rem;
				font-size: 0.92rem;
				line-height: 1.6;
				color: var(--muted);
			}
			.open {
				display: inline-flex;
				gap: 0.5em;
				margin-top: auto;
				font-size: 0.86rem;
				font-weight: 500;
				color: var(--text-strong);
			}
			@media (max-width: 980px) {
				.sheets {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 620px) {
				.sheets {
					grid-template-columns: 1fr;
				}
				.sheet {
					min-height: 0;
				}
			}
		</style>
	</body>
</html>
