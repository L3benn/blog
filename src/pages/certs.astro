---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const certs = (await getCollection('certs')).sort(
	(a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Certifications - ${SITE_TITLE}`} description="My professional certifications" />
		<style>
			.cert-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
				gap: 1.5em;
				margin-top: 1.5em;
			}
			.cert-card {
				padding: 1.5em;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				overflow: hidden;
				transition: background 0.2s;
			}
			.cert-card:hover {
				background: rgba(40, 40, 40, 0.88);
			}
			.cert-card .badge {
				width: 100%;
				height: 300px;
				object-fit: cover;
				object-position: center;
				display: block;
				margin-bottom: 1em;
				background: #1a1a1a;
			}
			.cert-card h3 {
				margin: 0 0 0.3em;
				font-size: 1.1em;
				color: #e0ede6;
			}
			.cert-card .issuer {
				color: #8ab8a8;
				font-size: 0.85em;
				margin-bottom: 0.5em;
			}
			.cert-card .date {
				color: #5a8a7a;
				font-size: 0.8em;
				margin-bottom: 0.7em;
			}
			.cert-card .desc {
				color: #b8d4c8;
				font-size: 0.9em;
				line-height: 1.5;
				margin-bottom: 0.7em;
				flex: 1;
			}
			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-bottom: 1em;
			}
			.skill {
				background: rgba(79, 196, 184, 0.12);
				color: #6dd6ca;
				padding: 0.2em 0.6em;
				border-radius: 0;
				font-size: 0.75em;
			}
			.verify-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				color: #4fc4b8;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.85em;
			}
			.verify-link:hover {
				color: #6dd6ca;
				text-decoration: underline;
			}

			.journey-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.6em;
				padding: 0.65em 1.5em;
				background: #4fc4b8;
				color: #081c18;
				border-radius: 0;
				font-size: 0.9em;
				font-weight: 600;
				text-decoration: none;
				transition: background 0.2s;
			}
			.journey-btn:hover {
				background: #6dd6ca;
				color: #081c18;
			}
			.empty-state {
				text-align: center;
				padding: 3em 1em;
				color: #8ab8a8;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1em;margin-bottom:1.5em">
				<div>
					<h1 style="margin:0">Certifications</h1>
					<p style="margin:0.3em 0 0">Professional certifications I've earned, along with my journey preparing for each one.</p>
				</div>
				<a class="journey-btn" href="/certs/journeys/">
					View all journeys &rarr;
				</a>
			</div>

			{certs.length > 0 ? (
				<div class="cert-grid">
					{certs.map((cert) => (
						<div class="cert-card">
							{cert.data.badgeImage && <img class="badge" src={cert.data.badgeImage} alt={`${cert.data.title} badge`} />}
							<h3>{cert.data.title}</h3>
							<div class="issuer">{cert.data.issuer}</div>
							<div class="date">Earned <FormattedDate date={cert.data.dateEarned} /></div>
							{cert.data.description && <p class="desc">{cert.data.description}</p>}
							{cert.data.skills.length > 0 && (
								<div class="skills">
									{cert.data.skills.map((s) => <span class="skill">{s}</span>)}
								</div>
							)}
							{cert.data.verifyUrl && (
								<a class="verify-link" href={cert.data.verifyUrl} target="_blank">
									Verify credential &nearr;
								</a>
							)}
						</div>
					))}
				</div>
			) : (
				<div class="empty-state">
					<p>No certifications added yet.</p>
				</div>
			)}


		</main>
		<Footer />
	</body>
</html>
