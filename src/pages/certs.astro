---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_TITLE } from '../consts';

const certs = (await getCollection('certs')).sort(
	(a, b) => b.data.dateEarned.valueOf() - a.data.dateEarned.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Certifications - ${SITE_TITLE}`} description="My professional certifications" />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader eyebrow="Certifications" lead="Professional certifications I've earned, along with my journey preparing for each one.">
				Earned, <em>not given.</em>
				<a slot="actions" class="btn btn-ghost" href="/certs/journeys/">
					Read the journeys <span class="arrow" aria-hidden="true">&rarr;</span>
				</a>
			</PageHeader>

			{certs.length > 0 ? (
				<div class="cert-grid">
					{certs.map((cert, i) => (
						<article class="card hoverable cert" data-reveal style={`--i:${i % 2}`}>
							{cert.data.badgeImage && (
								<div class="shot">
									<img src={cert.data.badgeImage} alt={`${cert.data.title} certificate`} loading="lazy" decoding="async" />
								</div>
							)}
							<div class="body">
								<p class="meta">
									<span>{cert.data.issuer}</span>
									<FormattedDate date={cert.data.dateEarned} />
								</p>
								<h2>{cert.data.title}</h2>
								{cert.data.description && <p class="desc">{cert.data.description}</p>}
								{cert.data.skills.length > 0 && (
									<details>
										<summary>{cert.data.skills.length} skills covered</summary>
										<div class="skills">
											{cert.data.skills.map((s) => <span class="tag">{s}</span>)}
										</div>
									</details>
								)}
								{cert.data.verifyUrl && (
									<a class="link-arrow verify" href={cert.data.verifyUrl} target="_blank" rel="noopener">
										Verify credential <span class="arrow" aria-hidden="true">&nearr;</span>
									</a>
								)}
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="empty-state">
					<p>No certifications added yet.</p>
				</div>
			)}
		</main>
		<Footer />
		<style>
			.cert-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				align-items: start;
			}
			.cert {
				display: flex;
				flex-direction: column;
			}
			.shot {
				aspect-ratio: 16 / 10;
				overflow: hidden;
				background: var(--surface-2);
				border-bottom: 1px solid var(--line);
			}
			.shot img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.9s var(--ease);
			}
			.cert:hover .shot img {
				transform: scale(1.03);
			}
			.body {
				padding: 1.6rem 1.7rem 1.5rem;
			}
			.meta {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin: 0 0 0.9rem;
				font-family: var(--mono);
				font-size: 0.72rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--faint);
			}
			.meta span {
				color: var(--accent);
			}
			.cert h2 {
				margin: 0 0 0.7rem;
				font-size: 1.35rem;
				line-height: 1.2;
			}
			.desc {
				margin: 0 0 1.3rem;
				font-size: 0.94rem;
				line-height: 1.6;
				color: var(--muted);
			}
			details {
				margin-bottom: 1.3rem;
				border-top: 1px solid var(--line);
				border-bottom: 1px solid var(--line);
			}
			summary {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.8rem 0;
				font-size: 0.88rem;
				font-weight: 500;
				color: var(--text-strong);
				cursor: pointer;
				list-style: none;
			}
			summary::-webkit-details-marker {
				display: none;
			}
			summary::after {
				content: '+';
				font-family: var(--mono);
				font-size: 1.1rem;
				font-weight: 400;
				color: var(--muted);
				transition: transform 0.3s var(--ease);
			}
			details[open] summary::after {
				transform: rotate(45deg);
			}
			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				padding-bottom: 1rem;
			}
			.verify {
				color: var(--text-strong);
			}
			.verify:hover {
				color: var(--accent-light);
			}
			@media (max-width: 820px) {
				.cert-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
