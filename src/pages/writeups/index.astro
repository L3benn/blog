---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const count = (tag: string) => posts.filter((p) => p.data.tags?.includes(tag)).length;
const categories = [
	{
		href: '/writeups/ctf',
		title: 'CTF tasks',
		text: 'Capture The Flag challenge solutions and exploit chains.',
		n: count('ctf'),
		icon: 'M5 21V4m0 1h11l-2 4 2 4H5',
	},
	{
		href: '/writeups/htb',
		title: 'HTB machines',
		text: 'Hack The Box walkthroughs — from recon to root.',
		n: count('htb'),
		icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writeups - ${SITE_TITLE}`} description="CTF and HTB machine writeups" />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader eyebrow="Writeups" lead="Detailed walkthroughs for CTF challenges and Hack The Box machines.">
				Every exploit, <em>explained.</em>
			</PageHeader>

			<div class="categories">
				{categories.map((c, i) => (
					<a class="card category" href={c.href} data-reveal style={`--i:${i}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d={c.icon} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<div>
							<h2>{c.title}</h2>
							<p>{c.text}</p>
						</div>
						<span class="n">{c.n} <span class="arrow" aria-hidden="true">&rarr;</span></span>
					</a>
				))}
			</div>

			<section class="section">
				<div class="section-head" data-reveal>
					<div>
						<p class="eyebrow">Archive</p>
						<h2>All writeups</h2>
					</div>
				</div>
				<PostList posts={posts} filter empty="No writeups yet." />
			</section>
		</main>
		<Footer />

		<style>
			.categories {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
			}
			.category {
				display: flex;
				align-items: center;
				gap: 1.4rem;
				padding: 1.6rem 1.8rem;
			}
			.category svg {
				flex-shrink: 0;
				width: 48px;
				height: 48px;
				padding: 11px;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.08);
				border: 1px solid rgba(var(--accent-rgb), 0.2);
				border-radius: 13px;
			}
			.category h2 {
				margin: 0 0 0.25rem;
				font-size: 1.25rem;
			}
			.category p {
				margin: 0;
				font-size: 0.92rem;
				color: var(--muted);
			}
			.n {
				display: inline-flex;
				gap: 0.6em;
				margin-left: auto;
				font-family: var(--mono);
				font-size: 0.85rem;
				color: var(--text-strong);
				white-space: nowrap;
			}
			@media (max-width: 760px) {
				.categories {
					grid-template-columns: 1fr;
				}
				.category {
					padding: 1.3rem;
					gap: 1rem;
				}
			}
		</style>
	</body>
</html>
