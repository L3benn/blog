---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writeups - ${SITE_TITLE}`} description="CTF and HTB machine writeups" />
		<style>
			.categories {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
				margin-top: 2em;
			}
			.card {
				
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 0;
				padding: 2em;
				text-decoration: none;
				transition: background 0.2s;
			}
			.card:hover {
				background: rgba(40, 40, 40, 0.88);
			}
			.card h2 {
				margin: 0 0 0.4em;
				color: #e0ede6;
			}
			.card p {
				color: #8ab8a8;
				margin: 0;
				font-size: 0.92em;
				line-height: 1.6;
			}
			.card .icon {
				font-size: 2.2em;
				margin-bottom: 0.5em;
				display: block;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Writeups</h1>
			<p>Detailed walkthroughs for CTF challenges and HTB machines.</p>

			<div class="categories">
				<a class="card" href="/writeups/htb">
					<span class="icon">&#x1F4E6;</span>
					<h2>HTB Machines</h2>
					<p>Hack The Box machine walkthroughs — from recon to root.</p>
				</a>
				<a class="card" href="/writeups/ctf">
					<span class="icon">&#x1F3AF;</span>
					<h2>CTF Tasks</h2>
					<p>Capture The Flag challenge solutions and exploit writeups.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
